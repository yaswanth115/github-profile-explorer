# Optional. A GitHub token raises the API rate limit from 60 to 5,000 requests/hour.
# IMPORTANT: Vite exposes VITE_* variables to the browser bundle. Only use a token
# with NO scopes (public data only) for local development, and never commit .env.
# For production, prefer proxying GitHub requests through a server that holds the token,
# then point VITE_GITHUB_API_URL at that proxy.
VITE_GITHUB_TOKEN=

# Optional. Override the API base URL (default: https://api.github.com).
VITE_GITHUB_API_URL=https://api.github.com
